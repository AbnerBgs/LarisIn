// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Kategori {
  id     String   @id @default(dbgenerated("gen_random_uuid()::text"))
  nama   String   @unique
  produk Produk[]
}

model Produk {
  id           String         @id @default(dbgenerated("gen_random_uuid()::text"))
  nama         String
  deskripsi    String?
  harga        Int
  gambarUrl    String?
  stok         Int            @default(0)
  kategoriId   String?        
  kategori     Kategori?      @relation(fields: [kategoriId], references: [id]) // <-- Tambah tanda ? di sini
  penjualanItem PenjualanItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Penjualan {
  id          String          @id @default(dbgenerated("gen_random_uuid()::text"))
  orderNumber String          @unique
  cashierName String
  paymentType String
  total       Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       PenjualanItem[]
}

model PenjualanItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  penjualanId String
  penjualan   Penjualan @relation(fields: [penjualanId], references: [id], onDelete: Cascade)
  produkId    String?
  produk      Produk?   @relation(fields: [produkId], references: [id])
  productName String
  price       Int
  quantity    Int
  createdAt   DateTime  @default(now())
}

model Profile {
  id          String   @id @default("default-profile")
  name        String   @default("Nama Usaha")
  category    String?
  street      String?
  district    String?
  city        String?
  province    String?
  postalCode  String?
  whatsapp    String?
  openHours   String? 
  jobsText    String?
  linkInsta   String?
  linkFb      String?
  linkWeb     String?
  description String?
  updatedAt   DateTime @updatedAt
}