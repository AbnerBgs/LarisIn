// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// AUTH — Identitas pemilik data berasal dari sesi Clerk.
// User dibuat malas (lazy) saat request pertama lewat `ensureUser()`.
// =====================================================================
model User {
  id        String   @id // Clerk userId, mis. "user_2x..."
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile          UmkmProfile?
  kategori         Kategori[]
  produk           Produk[]
  penjualan        Penjualan[]
  transaksi        TransaksiKeuangan[]
  targetPendapatan TargetPendapatan?
}

// =====================================================================
// PROFIL UMKM — 1 user = 1 profil usaha yang ditampilkan di direktori
// publik (/cek-umkm). Profil muncul di direktori setelah disimpan (PUT).
// =====================================================================
model UmkmProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   @default("Nama Usaha")
  category    String? // kuliner | fashion | kerajinan | jasa | pertanian
  street      String?
  district    String?
  city        String?
  province    String?
  postalCode  String?
  whatsapp    String?
  openHours   String?
  jobsText    String?
  linkInsta   String?
  linkFb      String?
  linkWeb     String?
  description String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =====================================================================
// KATALOG PRODUK
// =====================================================================
model Kategori {
  id     String   @id @default(dbgenerated("gen_random_uuid()::text"))
  nama   String
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  produk Produk[]

  @@unique([userId, nama])
}

model Produk {
  id            String          @id @default(dbgenerated("gen_random_uuid()::text"))
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  nama          String
  deskripsi     String?
  harga         Int
  gambarUrl     String?
  stok          Int             @default(0)
  kategoriId    String?
  kategori      Kategori?       @relation(fields: [kategoriId], references: [id], onDelete: SetNull)
  penjualanItem PenjualanItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// =====================================================================
// PENJUALAN (kasir)
// =====================================================================
model Penjualan {
  id          String          @id @default(dbgenerated("gen_random_uuid()::text"))
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderNumber String
  cashierName String
  paymentType String
  total       Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       PenjualanItem[]

  @@unique([userId, orderNumber])
}

model PenjualanItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  penjualanId String
  penjualan   Penjualan @relation(fields: [penjualanId], references: [id], onDelete: Cascade)
  produkId    String?
  produk      Produk?   @relation(fields: [produkId], references: [id], onDelete: SetNull)
  productName String
  price       Int
  quantity    Int
  createdAt   DateTime  @default(now())
}

// =====================================================================
// KEUANGAN — transaksi pendapatan/pengeluaran halaman Keuangan.
// `date` = tanggal transaksi (yyyy-mm-dd) yang dipilih pengguna.
// =====================================================================
model TransaksiKeuangan {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // "income" | "expense"
  description String
  amount      Int // selalu positif — arah ditentukan `type`
  category    String
  date        DateTime @db.Date
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =====================================================================
// TARGET PENDAPATAN — target bulanan (IDR) yang ingin dicapai user.
// Dipakai di halaman Dashboard (garis target grafik) dan Keuangan.
// =====================================================================
model TargetPendapatan {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int      @default(0) // target pendapatan bulanan (IDR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
